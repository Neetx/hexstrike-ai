{
  "mcpServers": {
    "hexstrike-ai": {
      "command": "/usr/local/bin/docker",
      "args": [
        "exec",
        "-i",
        "hexstrike-ai-server",
        "python3",
        "/app/hexstrike_mcp.py",
        "--server",
        "http://127.0.0.1:8888"
      ],
      "description": "HexStrike AI v6.1 Docker-hosted stdio MCP bridge",
      "timeout": 300,
      "disabled": false
    }
  }
}
